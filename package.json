{
  "name": "lanre-ds",
  "version": "0.1.0",
  "private": true,
  "description": "Lanre: a design system for a casual exploration game. React components and CSS tokens.",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "npm run dev -w docs",
    "build-docs": "npm run build -w docs",
    "pack:check": "npm pack --dry-run"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./tokens/*.css": "./tokens/*.css",
    "./components/map/worlds": {
      "types": "./components/map/worlds.d.ts",
      "default": "./components/map/worlds.js"
    },
    "./components/*": {
      "types": "./components/*.d.ts",
      "default": "./components/*.jsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "tokens",
    "styles.css",
    "tools/ds-loader.js",
    "readme.md",
    "!**/*.card.html"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
